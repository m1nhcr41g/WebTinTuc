<h2>Quản lý người dùng</h2>

@if (TempData["Error"] != null)
{
    <p style="color:red">@TempData["Error"]</p>
}

<p><strong>👤 Khách hàng:</strong> @ViewBag.UserCount</p>
<p><strong>🧑‍💻 Nhà báo:</strong> @ViewBag.JournalistCount</p>

<hr />

<h3>Danh sách khách hàng</h3>
<table class="table">
    @foreach (var user in ViewBag.Users)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.FullName</td>
            <td>
                <a href="/AdminUsers/Delete/@user.Id"
                   class="text-danger"
                   onclick="return confirm('Xóa user này?')">
                    Xóa
                </a>
            </td>
        </tr>
    }
</table>

<h3>Danh sách nhà báo</h3>
<table class="table">
    @foreach (var user in ViewBag.Journalists)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.FullName</td>
            <td>
                <a href="/AdminUsers/Delete/@user.Id"
                   class="text-danger"
                   onclick="return confirm('Xóa nhà báo này?')">
                    Xóa
                </a>
            </td>
        </tr>
    }
</table>