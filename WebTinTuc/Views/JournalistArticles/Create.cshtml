@model WebTinTuc.Models.Articles.ArticleFormViewModel

@{
    ViewData["Title"] = "Viet bai moi";
}

<h1 class="h3 mb-3">Viet bai moi</h1>

<div class="article-form-shell">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="article-form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="article-form-grid">
            <div class="article-form-main">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Vi du: U23 Viet Nam co tran mo man an tuong" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Summary" class="form-label"></label>
                    <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Tom tat ngan gon noi dung bai viet"></textarea>
                    <span asp-validation-for="Summary" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ThumbnailUrl" class="form-label"></label>
                    <input asp-for="ThumbnailFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-text">Bat buoc tai thumbnail tu may (JPG, PNG, WEBP, toi da 4MB).</div>
                    <span asp-validation-for="ThumbnailFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" id="article-content-textarea" class="form-control" rows="12"></textarea>
                    <div id="article-editor" class="article-editor d-none"></div>
                    <div class="form-text">Ban co the nhap noi dung o textarea. Neu editor nang cao tai duoc, ban co the chen hinh anh tai vi tri con tro.</div>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
            </div>

            <aside class="article-form-side">
                <div class="article-form-panel mb-3">
                    <label asp-for="CategoryId" class="form-label">Chuyen muc</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Khong chon</option>
                        @foreach (var category in Model.AvailableCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="article-form-panel mb-3">
                    <label asp-for="NewTags" class="form-label">Them tags moi (khong bat buoc)</label>
                    <input asp-for="NewTags" id="new-tags-input" type="hidden" />
                    <div class="input-group mb-2">
                        <input id="new-tag-entry" type="text" class="form-control" list="existing-tags-list-create" placeholder="Nhap tag, vi du: #bongda" />
                        <button id="add-tag-button" type="button" class="btn btn-outline-primary">Them tag</button>
                    </div>
                    <datalist id="existing-tags-list-create">
                        @foreach (var tag in Model.AvailableTags)
                        {
                            <option value="#@tag.Name"></option>
                        }
                    </datalist>
                    <div class="small text-muted mb-1">Tags se them:</div>
                    <div id="new-tags-chip-list" class="d-flex flex-wrap gap-2"></div>
                    <div class="form-text">Tag phai bat dau bang #. Khi go, he thong se goi y tu danh sach tag da co.</div>
                    <span asp-validation-for="NewTags" class="text-danger"></span>
                </div>
            </aside>
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary">Dang bai</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lai</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script>
        (function () {
            const form = document.querySelector('form[asp-action="Create"]') || document.querySelector('form');
            const textarea = document.getElementById('article-content-textarea');
            const editorHost = document.getElementById('article-editor');
            const newTagsInput = document.getElementById('new-tags-input');
            const newTagEntry = document.getElementById('new-tag-entry');
            const addTagButton = document.getElementById('add-tag-button');
            const chipList = document.getElementById('new-tags-chip-list');
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const uploadUrl = '@Url.Action("UploadImage", "JournalistArticles")';

            const tagSet = new Set();

            const normalizeTag = (value) => {
                return (value || '')
                    .trim()
                    .replace(/^#+/, '')
                    .trim()
                    .replace(/\s+/g, ' ')
                    .toLocaleLowerCase('vi-VN');
            };

            const enforceHashtagPrefix = () => {
                const current = (newTagEntry.value || '').trimStart();
                if (!current) {
                    return;
                }

                if (!current.startsWith('#')) {
                    newTagEntry.value = `#${current.replace(/^#+/, '')}`;
                }
            };

            const syncTagInput = () => {
                newTagsInput.value = Array.from(tagSet).join(', ');
            };

            const renderTagChips = () => {
                chipList.innerHTML = '';
                Array.from(tagSet).forEach((tag) => {
                    const chip = document.createElement('span');
                    chip.className = 'tag-editor-chip';

                    const label = document.createElement('span');
                    label.className = 'tag-editor-chip-label';
                    label.textContent = `#${tag}`;
                    chip.appendChild(label);

                    const editButton = document.createElement('button');
                    editButton.type = 'button';
                    editButton.className = 'btn btn-sm btn-outline-light tag-editor-chip-btn';
                    editButton.textContent = 'Sua';
                    editButton.addEventListener('click', () => {
                        const edited = prompt('Sua tag:', `#${tag}`);
                        if (edited === null) {
                            return;
                        }

                        const normalized = normalizeTag(edited);
                        if (!normalized) {
                            return;
                        }

                        const key = normalized.toLowerCase();
                        const duplicate = [...tagSet].some(existing => existing.toLowerCase() === key && existing.toLowerCase() !== tag.toLowerCase());
                        if (duplicate) {
                            return;
                        }

                        tagSet.delete(tag);
                        tagSet.add(normalized);
                        renderTagChips();
                        syncTagInput();
                    });

                    const removeButton = document.createElement('button');
                    removeButton.type = 'button';
                    removeButton.className = 'btn btn-sm btn-outline-light tag-editor-chip-btn';
                    removeButton.textContent = 'Xoa';
                    removeButton.setAttribute('aria-label', 'Xoa tag');
                    removeButton.addEventListener('click', () => {
                        tagSet.delete(tag);
                        renderTagChips();
                        syncTagInput();
                    });

                    chip.appendChild(editButton);
                    chip.appendChild(removeButton);
                    chipList.appendChild(chip);
                });
            };

            const addTag = (value) => {
                const normalized = normalizeTag(value);
                if (!normalized) {
                    return;
                }

                const key = normalized.toLowerCase();
                if ([...tagSet].some(tag => tag.toLowerCase() === key)) {
                    return;
                }

                tagSet.add(normalized);
                renderTagChips();
                syncTagInput();
            };

            (newTagsInput.value || '').split(',').forEach(addTag);
            renderTagChips();
            syncTagInput();

            addTagButton.addEventListener('click', () => {
                addTag(newTagEntry.value);
                newTagEntry.value = '';
                newTagEntry.focus();
            });

            newTagEntry.addEventListener('input', enforceHashtagPrefix);
            newTagEntry.addEventListener('blur', enforceHashtagPrefix);

            newTagEntry.addEventListener('keydown', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    addTagButton.click();
                }
            });

            if (typeof window.Quill !== 'function') {
                form.addEventListener('submit', syncTagInput);
                return;
            }

            const quill = new Quill('#article-editor', {
                theme: 'snow',
                placeholder: 'Nhap noi dung bai viet...',
                modules: {
                    toolbar: [
                        [{ header: [2, 3, false] }],
                        ['bold', 'italic', 'underline', 'blockquote'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ]
                }
            });

            quill.root.innerHTML = textarea.value || '';

            const syncContent = function () {
                textarea.value = quill.root.innerHTML;
            };

            quill.on('text-change', syncContent);
            syncContent();

            textarea.classList.add('d-none');
            editorHost.classList.remove('d-none');

            const toolbar = quill.getModule('toolbar');
            toolbar.addHandler('image', function () {
                const input = document.createElement('input');
                input.setAttribute('type', 'file');
                input.setAttribute('accept', 'image/*');
                input.click();

                input.onchange = async function () {
                    if (!input.files || input.files.length === 0) {
                        return;
                    }

                    const file = input.files[0];
                    const formData = new FormData();
                    formData.append('image', file);

                    try {
                        const response = await fetch(uploadUrl, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                            },
                            body: formData
                        });

                        if (!response.ok) {
                            throw new Error('Upload that bai.');
                        }

                        const data = await response.json();
                        const range = quill.getSelection(true) || { index: quill.getLength(), length: 0 };
                        quill.insertEmbed(range.index, 'image', data.url, 'user');
                        quill.setSelection(range.index + 1, 0);
                    } catch (error) {
                        alert('Khong the tai anh len. Vui long thu lai.');
                    }
                };
            });

            form.addEventListener('submit', function () {
                syncContent();
                syncTagInput();
            });
        })();
    </script>
}
