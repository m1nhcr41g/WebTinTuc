@model WebTinTuc.Models.Articles.NewsIndexViewModel

@{
    ViewData["Title"] = "Tin tuc";

    string[] ExtractTags(string? tagsText)
    {
        return (tagsText ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(tag => tag.Trim())
            .Where(tag => !string.IsNullOrWhiteSpace(tag))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }
}

<div class="news-page">
    <section class="news-hero mb-4">
        <h1 class="h2 mb-2">Tin tuc</h1>
        <p class="mb-0 text-light-emphasis">Cap nhat nhanh tin bong da, sap xep theo do hot, thoi gian va chuyen muc.</p>
    </section>

    @{
        var hasFocusedFilter = !string.IsNullOrWhiteSpace(Model.SelectedTag) || !string.IsNullOrWhiteSpace(Model.SelectedCategorySlug);
    }

    <div class="news-layout">
        <div class="news-main-column">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedCategorySlug))
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center news-filter-alert">
                    <span>
                        Dang loc theo chuyen muc:
                        <strong>@(string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? Model.SelectedCategorySlug : Model.SelectedCategoryName)</strong>
                    </span>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tat ca</a>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SelectedTag))
            {
                <div class="alert alert-primary d-flex justify-content-between align-items-center news-filter-alert">
                    <span>
                        Dang loc theo tag:
                        <strong>@Model.SelectedTag</strong>
                    </span>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Bo loc tag</a>
                </div>
            }

            @if (hasFocusedFilter)
            {
                <section class="news-block mb-4">
                    <div class="news-block-header mb-3">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedTag))
                        {
                            <h2 class="h4 mb-0">Bai viet lien quan tag "@Model.SelectedTag"</h2>
                        }
                        else
                        {
                            <h2 class="h4 mb-0">Bai viet trong chuyen muc "@(string.IsNullOrWhiteSpace(Model.SelectedCategoryName) ? Model.SelectedCategorySlug : Model.SelectedCategoryName)"</h2>
                        }
                    </div>

                    @if (Model.FilteredArticles.Count == 0)
                    {
                        <div class="alert alert-secondary mb-0">Khong co bai viet nao phu hop bo loc hien tai.</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var article in Model.FilteredArticles)
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <article class="news-card h-100">
                                        <img src="@article.ThumbnailUrl" alt="@article.Title" class="news-thumb mb-2" loading="lazy" />
                                        <h3 class="h6 mb-2">
                                            <a asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none">@article.Title</a>
                                        </h3>
                                        <p class="small text-muted mb-2">@article.Summary</p>
                                        <div class="tag-chip-wrap mb-2">
                                            @foreach (var tag in ExtractTags(article.TagsText))
                                            {
                                                <a asp-action="Index" asp-route-tag="@tag" class="tag-chip">#@tag</a>
                                            }
                                        </div>
                                        <div class="news-meta small text-muted d-flex justify-content-between">
                                            <span>@article.ViewCount luot xem</span>
                                            <span>@article.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (!hasFocusedFilter && User.Identity?.IsAuthenticated == true && User.IsInRole("User"))
            {
                <section class="news-block mb-4">
                    <div class="news-block-header d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h4 mb-0">Goi y cho ban</h2>
                        <a asp-controller="UserPreferences" asp-action="Setup" class="small">Chinh sua so thich</a>
                    </div>

                    @if (Model.PreferenceKeywords.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Ban chua chon doi bong/giai dau yeu thich.
                            <a asp-controller="UserPreferences" asp-action="Setup" class="alert-link">Chon ngay</a>
                            de nhan goi y ca nhan hoa.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">So thich: @string.Join(", ", Model.PreferenceKeywords)</p>

                        @if (Model.RecommendedArticles.Count == 0)
                        {
                            <div class="alert alert-secondary mb-0">Chua tim thay bai viet phu hop voi so thich hien tai.</div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var article in Model.RecommendedArticles)
                                {
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <article class="news-card h-100">
                                            <img src="@article.ThumbnailUrl" alt="@article.Title" class="news-thumb mb-2" loading="lazy" />
                                            <h3 class="h6 mb-2">
                                                <a asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none">@article.Title</a>
                                            </h3>
                                            <p class="small text-muted mb-2">@article.Summary</p>
                                            @if (!string.IsNullOrWhiteSpace(article.TagsText))
                                            {
                                                <div class="tag-chip-wrap mb-3">
                                                    @foreach (var tag in ExtractTags(article.TagsText))
                                                    {
                                                        <a asp-action="Index" asp-route-tag="@tag" class="tag-chip">#@tag</a>
                                                    }
                                                </div>
                                            }
                                            <div class="news-meta small text-muted d-flex justify-content-between">
                                                <span>@article.ViewCount luot xem</span>
                                                <span>@article.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                        </article>
                                    </div>
                                }
                            </div>
                            }
                        }
                    }
                </section>
            }

            @if (!hasFocusedFilter)
            {
            <section class="news-block mb-4">
                <div class="news-block-header d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">Tin hot</h2>
                    <span class="text-muted">Sap xep theo luot xem</span>
                </div>

                @if (Model.HotArticles.Count == 0)
                {
                    <div class="alert alert-info">Chua co bai viet nao.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var article in Model.HotArticles)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <article class="news-card hot-card h-100">
                                    <img src="@article.ThumbnailUrl" alt="@article.Title" class="news-thumb mb-2" loading="lazy" />
                                    <h3 class="h5 mb-2">
                                        <a asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none">@article.Title</a>
                                    </h3>  
                                    <p class="text-muted mb-3">@article.Summary</p>
                                    <div class="tag-chip-wrap mb-3">
                                        @foreach (var tag in ExtractTags(article.TagsText))
                                        {
                                            <a asp-action="Index" asp-route-tag="@tag" class="tag-chip">#@tag</a>
                                        }
                                    </div>
                                    <div class="news-meta small text-muted d-flex justify-content-between">
                                        <span>@article.ViewCount luot xem</span>
                                        <span>@article.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="news-block mb-4">
                <div class="news-block-header mb-3">
                    <h2 class="h4 mb-0">Tin moi nhat</h2>
                </div>

                @if (Model.LatestArticles.Count == 0)
                {
                    <div class="alert alert-info">Chua co bai viet nao.</div>
                }
                else
                {
                    <div class="news-list">
                        @foreach (var article in Model.LatestArticles)
                        {
                            <article class="news-list-item">
                                <div class="d-flex w-100 justify-content-between align-items-start gap-3">
                                    <div class="d-flex gap-3 align-items-start">
                                        <img src="@article.ThumbnailUrl" alt="@article.Title" class="news-list-thumb" loading="lazy" />
                                        <div>
                                        <h3 class="h6 mb-1">
                                            <a asp-action="Details" asp-route-slug="@article.Slug" class="text-decoration-none">@article.Title</a>
                                        </h3>
                                        <p class="mb-1 text-muted">@article.Summary</p>
                                        <div class="tag-chip-wrap mb-1">
                                            @foreach (var tag in ExtractTags(article.TagsText))
                                            {
                                                <a asp-action="Index" asp-route-tag="@tag" class="tag-chip">#@tag</a>
                                            }
                                        </div>
                                        <small class="text-muted">@article.ViewCount luot xem</small>
                                        </div>
                                    </div>
                                    <small class="text-muted text-nowrap">@article.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
            }
        </div>

        <aside class="news-side-column">
            <section class="news-block">
                <div class="news-block-header mb-3">
                    <h2 class="h4 mb-0">Tin tuc theo chuyen muc</h2>
                </div>

                @if (Model.CategorySections.Count == 0)
                {
                    <div class="alert alert-secondary">Chua co du lieu theo categories.</div>
                }
                else
                {
                    <div class="category-box-grid">
                        @foreach (var categorySection in Model.CategorySections)
                        {
                            <section class="category-box">
                                <div class="category-box-head d-flex justify-content-between align-items-center">
                                    <h3 class="h5 mb-0">
                                        <a asp-action="Index" asp-route-category="@categorySection.CategorySlug" class="text-decoration-none category-box-title-link">@categorySection.CategoryName</a>
                                    </h3>
                                    <span class="small text-muted">@categorySection.TotalViewCount luot xem</span>
                                </div>

                                <div class="category-box-list">
                                    @for (var i = 0; i < Math.Min(3, categorySection.Articles.Count); i++)
                                    {
                                        var article = categorySection.Articles[i];
                                        var hasThumb = i == 0;

                                        <article class="category-box-item @(hasThumb ? string.Empty : "category-box-item-no-thumb")">
                                            @if (hasThumb)
                                            {
                                                <img src="@article.ThumbnailUrl" alt="@article.Title" class="category-box-thumb" loading="lazy" />
                                            }
                                            <div>
                                                <a asp-action="Details" asp-route-slug="@article.Slug" class="fw-semibold text-decoration-none">@article.Title</a>
                                                <p class="mb-2 text-muted small">@article.Summary</p>
                                                <div class="tag-chip-wrap mb-2">
                                                    @foreach (var tag in ExtractTags(article.TagsText))
                                                    {
                                                        <a asp-action="Index" asp-route-tag="@tag" class="tag-chip">#@tag</a>
                                                    }
                                                </div>
                                                <div class="news-meta small text-muted d-flex justify-content-between gap-3">
                                                    <span>@article.ViewCount luot xem</span>
                                                    <span>@article.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </section>
        </aside>
    </div>
</div>
